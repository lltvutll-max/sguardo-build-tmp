    "Поставь его из чата или карточки клиента — или нажми подсказку «Обещает оплатить»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie sie im Chat oder in der Kundenkarte an – oder tippen Sie auf den Hinweis „Verspricht zu zahlen“."
          }
        },
        "en" : {
          "stringUnit" : {

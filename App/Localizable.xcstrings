    "Входящие переводим на русский автоматически — перевод под сообщением. Вы пишете по-русски, а клиенту уходит на %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingehende Nachrichten werden automatisch in Ihre Sprache übersetzt – die Übersetzung steht unter der Nachricht. Sie schreiben in Ihrer Sprache, der Kunde erhält es auf %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incoming messages are translated into your language automatically — the translation is under each message. You write in your language, and the client receives it in %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes entrantes se traducen a tu idioma automáticamente; la traducción aparece debajo del mensaje. Tú escribes en tu idioma y el cliente lo recibe en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages reçus sont traduits automatiquement dans votre langue — la traduction s’affiche sous le message. Vous écrivez dans votre langue, et le client reçoit le message en %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi in arrivo vengono tradotti automaticamente nella tua lingua: la traduzione è sotto il messaggio. Tu scrivi nella tua lingua e il cliente riceve in %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości przychodzące tłumaczymy automatycznie na Twój język — tłumaczenie jest pod wiadomością. Piszesz w swoim języku, a klient dostaje odpowiedź w języku: %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens recebidas são traduzidas para o seu idioma automaticamente — a tradução fica abaixo da mensagem. Você escreve no seu idioma, e o cliente recebe em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входящие переводим на русский автоматически — перевод под сообщением. Вы пишете по-русски, а клиенту уходит на %@."
          }
        }
      }
    },

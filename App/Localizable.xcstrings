    "Клиент пишет на %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde schreibt auf %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Client writes in %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cliente escribe en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le client écrit en %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cliente scrive in %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język klienta: %@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cliente escreve em %@"
          }
        },
        "ru" : {
          "stringUnit" : {

    "Ответить, скопировать или удалить у всех. Смахните пузырь влево — быстрый ответ." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten, kopieren oder für alle löschen. Blase nach links wischen für schnelle Antwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reply, copy or delete for everyone. Swipe a bubble left for a quick reply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responder, copiar o eliminar para todos. Desliza la burbuja a la izquierda para responder rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondre, copier ou supprimer pour tous. Balayez une bulle vers la gauche pour répondre vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi, copia o elimina per tutti. Scorri il fumetto a sinistra per rispondere al volo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedz, skopiuj lub usuń u wszystkich. Przesuń dymek w lewo — szybka odpowiedź."
          }
        },
        "pt" : {
          "stringUnit" : {

    "Чтобы переложить сюда клиента, смахните его чат влево и нажмите «В папку»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um einen Kunden hierher zu verschieben, wischen Sie seinen Chat nach links und tippen Sie auf „In Ordner“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To move a client here, swipe their chat left and tap “To folder”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover un cliente aquí, desliza su chat a la izquierda y toca «A carpeta»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour déplacer un client ici, balayez son chat vers la gauche et touchez « Dans un dossier »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per spostare qui un cliente, scorri la sua chat a sinistra e tocca «In cartella»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przenieść tu klienta, przesuń jego czat w lewo i dotknij „Do folderu”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mover um cliente para cá, deslize a conversa para a esquerda e toque em “Para pasta”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы переложить сюда клиента, смахните его чат влево и нажмите «В папку»."
          }
        }
      }
    },
    "Чтобы подтвердить, введите слово «%@»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

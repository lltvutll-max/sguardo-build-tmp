    "Отметьте сразу несколько чатов — и переложите их в папку, прочитайте или закрепите одним нажатием." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markieren Sie mehrere Chats und verschieben Sie sie mit einem Tippen in einen Ordner, markieren Sie sie als gelesen oder heften Sie sie an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select several chats at once, then move them to a folder, mark as read or pin with one tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona varios chats a la vez y muévelos a una carpeta, márcalos como leídos o fíjalos con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez plusieurs chats, puis déplacez-les dans un dossier, marquez-les comme lus ou épinglez-les d'un seul geste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona più chat insieme e spostale in una cartella, segnale come lette o fissale con un tocco."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaznacz kilka czatów naraz — i przenieś je do folderu, oznacz jako przeczytane lub przypnij jednym stuknięciem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione vários chats de uma vez e mova para uma pasta, marque como lidos ou fixe com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте сразу несколько чатов — и переложите их в папку, прочитайте или закрепите одним нажатием."
          }
        }
      }
    },

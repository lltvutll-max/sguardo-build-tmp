    "Удерживай кнопку, чтобы записать голосовое" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taste halten, um eine Sprachnachricht aufzunehmen"
          }
        },
        "en" : {

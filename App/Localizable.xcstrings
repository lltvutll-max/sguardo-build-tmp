    "Папка — этап сделки, у клиента она одна. Нажми на название, чтобы переименовать." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ordner ist eine Deal-Phase; jeder Kunde ist in genau einem. Tippen Sie auf den Namen, um ihn umzubenennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder is a deal stage; each client is in one folder. Tap a name to rename it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carpeta es una etapa del trato; cada cliente está en una sola. Toca el nombre para renombrarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dossier est une étape de la vente ; chaque client en a un seul. Touchez le nom pour le renommer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cartella è una fase della trattativa; ogni cliente ne ha una sola. Tocca il nome per rinominarla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder to etap transakcji, klient ma tylko jeden. Stuknij nazwę, aby ją zmienić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta é uma etapa do negócio; cada cliente fica em uma só. Toque no nome para renomear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка — этап сделки, у клиента она одна. Нажми на название, чтобы переименовать."
          }
        }
      }
    },
    "Папка — этап сделки: новые, думает, оплатил. Метка — любая пометка, например «VIP». Смахните чат влево — «В папку»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ordner ist eine Deal-Phase: neu, überlegt, bezahlt. Ein Label ist eine beliebige Markierung, z. B. „VIP“. Wischen Sie einen Chat nach links – „In Ordner“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder is a deal stage: new, thinking, paid. A tag is any mark, like “VIP”. Swipe a chat left and tap “To folder”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una carpeta es una etapa del trato: nuevos, lo piensa, pagó. Una etiqueta es cualquier marca, por ejemplo «VIP». Desliza un chat a la izquierda: «A carpeta»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un dossier est une étape de la vente : nouveaux, réfléchit, a payé. Une étiquette est une marque libre, par exemple « VIP ». Balayez un chat vers la gauche : « Dans un dossier »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cartella è una fase della trattativa: nuovi, ci pensa, ha pagato. Un'etichetta è un segno qualsiasi, ad esempio «VIP». Scorri una chat a sinistra: «In cartella»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder to etap transakcji: nowi, zastanawia się, zapłacił. Tag to dowolne oznaczenie, np. „VIP”. Przesuń czat w lewo — „Do folderu”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta é uma etapa do negócio: novos, pensando, pagou. A etiqueta é qualquer marcação, por exemplo “VIP”. Deslize o chat para a esquerda: “Para pasta”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка — этап сделки: новые, думает, оплатил. Метка — любая пометка, например «VIP». Смахните чат влево — «В папку»."
          }
        }
      }
    },

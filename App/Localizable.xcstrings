    "Первое сообщение фирмам в WhatsApp — по одной, с паузами и дневным лимитом. Ответы приходят в обычные чаты." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erste Nachricht an Firmen per WhatsApp — einzeln, mit Pausen und Tageslimit. Antworten kommen in die normalen Chats."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First message to companies on WhatsApp — one at a time, with pauses and a daily limit. Replies arrive in your regular chats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer mensaje a empresas por WhatsApp — de una en una, con pausas y límite diario. Las respuestas llegan a los chats normales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier message aux entreprises sur WhatsApp — une par une, avec des pauses et une limite quotidienne. Les réponses arrivent dans les chats habituels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primo messaggio alle aziende su WhatsApp — una alla volta, con pause e limite giornaliero. Le risposte arrivano nelle chat normali."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwsza wiadomość do firm na WhatsApp — po jednej, z przerwami i limitem dziennym. Odpowiedzi przychodzą na zwykłe czaty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeira mensagem para empresas no WhatsApp — uma por vez, com pausas e limite diário. As respostas chegam nas conversas normais."

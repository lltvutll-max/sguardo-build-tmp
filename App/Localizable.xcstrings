            "value" : "Set one from a chat or client card, or tap the “Promises to pay” hint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créalo desde un chat o la ficha del cliente, o toca la sugerencia «Promete pagar»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

    "Сообщение пропадёт и у клиента, и здесь. Вернуть будет нельзя." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht verschwindet beim Kunden und hier. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message will disappear for the client and here. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mensaje desaparecerá para el cliente y aquí. No se podrá recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le message disparaîtra chez le client et ici. Action irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il messaggio sparirà per il cliente e qui. Non si potrà recuperare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomość zniknie u klienta i tutaj. Nie da się tego cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mensagem vai sumir para o cliente e aqui. Não será possível recuperá-la."

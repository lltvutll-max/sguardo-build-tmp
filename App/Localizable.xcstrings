    "Нет интернета — показываем последние данные. Отправка заработает, когда связь вернётся." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Internet. Es werden die letzten Daten angezeigt. Senden funktioniert wieder, sobald die Verbindung zurück ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No internet. Showing the latest data. Sending will work once you're back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin internet: mostramos los últimos datos. El envío funcionará cuando vuelva la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas d'internet : dernières données affichées. L'envoi fonctionnera dès le retour de la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione: mostriamo gli ultimi dati. L'invio funzionerà quando torna la rete."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak internetu — pokazujemy ostatnie dane. Wysyłanie zadziała po przywróceniu połączenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem internet: mostrando os dados mais recentes. O envio volta a funcionar quando a conexão voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет интернета — показываем последние данные. Отправка заработает, когда связь вернётся."
          }
        }
      }
    },

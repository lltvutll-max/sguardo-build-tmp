    "Рассылка работает на оплаченном тарифе. Оплатите кабинет — и раздел откроется сам." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Versand ist im bezahlten Tarif verfügbar. Bezahlen Sie das Konto — dann öffnet sich der Bereich automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outreach works on a paid plan. Pay for your account and this section will open automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío funciona con un plan de pago. Paga la cuenta y la sección se abrirá sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'envoi fonctionne avec une offre payante. Payez votre espace et la section s'ouvrira automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'invio funziona con un piano a pagamento. Paga l'account e la sezione si aprirà da sola."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłka działa w płatnym planie. Opłać panel, a sekcja otworzy się sama."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envio funciona no plano pago. Pague a conta e a seção abrirá sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассылка работает на оплаченном тарифе. Оплатите кабинет — и раздел откроется сам."
          }
        }
      }
    },

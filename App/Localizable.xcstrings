    "Закрепить сверху и отметить прочитанным или непрочитанным. Смахнёте до конца — сработает первое действие." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben anheften und als gelesen oder ungelesen markieren. Ganz durchwischen löst die erste Aktion aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin to the top and mark as read or unread. Swipe all the way to trigger the first action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijar arriba y marcar como leído o no leído. Desliza hasta el final para activar la primera acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épingler en haut et marquer comme lu ou non lu. Balayez jusqu'au bout pour lancer la première action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fissa in alto e segna come letto o non letto. Scorri fino in fondo per attivare la prima azione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypnij na górze i oznacz jako przeczytane lub nieprzeczytane. Przesuń do końca, aby wykonać pierwszą akcję."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixar no topo e marcar como lido ou não lido. Deslize até o fim para acionar a primeira ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепить сверху и отметить прочитанным или непрочитанным. Смахнёте до конца — сработает первое действие."
          }
        }
      }
    },

    "Номера проверяются и сообщения уходят только через ваш WhatsApp. Подключите его по QR-коду в веб-кабинете: «Каналы» → WhatsApp." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nummern werden nur über Ihr WhatsApp geprüft und Nachrichten nur darüber gesendet. Verbinden Sie es per QR-Code im Webkonto: „Kanäle“ → WhatsApp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numbers are checked and messages are sent only through your WhatsApp. Connect it by QR code in the web account: “Channels” → WhatsApp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números se comprueban y los mensajes se envían solo a través de tu WhatsApp. Conéctalo con un código QR en la cuenta web: «Canales» → WhatsApp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros sont vérifiés et les messages envoyés uniquement via votre WhatsApp. Connectez-le par QR code dans l'espace web : « Canaux » → WhatsApp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri vengono verificati e i messaggi inviati solo tramite il tuo WhatsApp. Collegalo con il codice QR nell'account web: «Canali» → WhatsApp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numery są sprawdzane, a wiadomości wysyłane tylko przez Twój WhatsApp. Podłącz go kodem QR w panelu webowym: „Kanały” → WhatsApp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números são verificados e as mensagens enviadas só pelo seu WhatsApp. Conecte-o por QR code na conta web: “Canais” → WhatsApp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номера проверяются и сообщения уходят только через ваш WhatsApp. Подключите его по QR-коду в веб-кабинете: «Каналы» → WhatsApp."
          }
        }
      }
    },

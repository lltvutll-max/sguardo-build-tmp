    "Рассылку настраивает и отправляет владелец кабинета. Если нужно добавить фирмы — попросите его." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontoinhaber richtet den Versand ein und sendet ihn. Um Firmen hinzuzufügen, wenden Sie sich an ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account owner sets up and sends outreach. To add companies, ask them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El titular de la cuenta configura y envía. Si necesitas añadir empresas, pídeselo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le propriétaire de l'espace configure et lance l'envoi. Pour ajouter des entreprises, demandez-lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il titolare dell'account configura e invia. Per aggiungere aziende, chiedi a lui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłkę konfiguruje i prowadzi właściciel panelu. Jeśli trzeba dodać firmy, poproś go."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dono da conta configura e envia. Para adicionar empresas, peça a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассылку настраивает и отправляет владелец кабинета. Если нужно добавить фирмы — попросите его."
